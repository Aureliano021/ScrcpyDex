                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="Android Robot Asset:" /><Run Text=" Portions reproduced or modified from work created and shared by Google (CC-BY 3.0)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Command Bar -->
        <Border Grid.Row="3" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Device Indicator & Status -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Command Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Device Connection Indicator & Session Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dynamic Device Connection Pill -->
                    <Border CornerRadius="18" Padding="14,6" Margin="0,0,14,0"
                            Background="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Border}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- LED Glow Indicator -->
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Dot}" />
                            <TextBlock Text="{Binding DeviceStatusPillText}"
                                       FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Text}" />
                        </StackPanel>
                    </Border>

                    <!-- Session State & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        <TextBlock Text="{Binding DeviceStatusDetails}"
                                   FontSize="11" Foreground="#8E8E8E" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="360" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Big Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Big "Start Samsung DeX" Button -->
                    <ui:Button Appearance="Primary"
                               Command="{Binding StartDeXCommand}"
                               Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="22,0" Margin="0,0,10,0"
                               FontSize="13.5" FontWeight="SemiBold"
                               ToolTip="Initialize DeX desktop session on secondary virtual display via scrcpy">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0" FontSize="16" />
                            <TextBlock Text="Start DeX Session" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- "Disconnect" Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding StopDeXCommand}"
                               Visibility="{Binding CanStop, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="18,0" Margin="0,0,10,0"
                               FontSize="13" FontWeight="Medium"
                               ToolTip="Gracefully stop streaming and release DeX virtual display">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="Disconnect" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Emergency "Forçar Fechamento" (Kill Switch) Button -->
                    <ui:Button Appearance="Danger"
                               Command="{Binding EmergencyKillCommand}"
                               Visibility="{Binding ShowForceCloseButton, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="16,0"
                               FontSize="13" FontWeight="SemiBold"
                               ToolTip="Forçar Fechamento Imediato: Encerra instantaneamente todos os processos do scrcpy e ADB">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="Forçar Fechamento" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
