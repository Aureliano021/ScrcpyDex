<ui:FluentWindow x:Class="ScrcpyDex.WinUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:ScrcpyDex.WinUI.Views"
        mc:Ignorable="d"
        Title="ScrcpyDeX — Settings"
        Height="760" Width="1040"
        MinHeight="680" MinWidth="940"
        WindowStartupLocation="CenterScreen"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="#FFFFFF"
        Background="#181818">

    <Window.Resources>
        <local:DeviceStatusToBrushConverter x:Key="DeviceStatusBrushConverter" />
        <local:InverseBooleanConverter x:Key="InverseBoolConverter" />
        <local:BitrateLabelConverter x:Key="BitrateConverter" />
        <local:LogEntryColorConverter x:Key="LogColorConverter" />
        <local:CountToVisibilityConverter x:Key="CountToVisConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Modern Fluent Segmented TabControl Style -->
        <Style x:Key="ModernTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Modern Segmented Pill Capsule Header -->
                            <Border Grid.Row="0"
                                    Background="#181818"
                                    BorderBrush="#2A2A2A"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,16"
                                    SnapsToDevicePixels="True">
                                <TabPanel IsItemsHost="True"
                                          Background="Transparent"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>

                            <!-- Selected Tab Page Content -->
                            <Border Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0">
                                <ContentPresenter ContentSource="SelectedContent"
                                                  Margin="0" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern Fluent Segmented TabItem Style -->
        <Style x:Key="ModernTabItem" TargetType="TabItem">
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,0,3,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#12FFFFFF" />
                                <Setter Property="Foreground" Value="#EEEEEE" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="#2D2D2D" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#404040" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabBorder" Property="Background" Value="#333333" />
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="#4D4D4D" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Settings Section Header Style -->
        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 0: TitleBar -->
            <RowDefinition Height="Auto" />
            <!-- 1: Top App Header -->
            <RowDefinition Height="Auto" />
            <!-- 2: Prerequisite Warning Banner -->
            <RowDefinition Height="Auto" />
            <!-- 3: Main Content (Tabs) -->
            <RowDefinition Height="*" />
            <!-- 4: Bottom Action Command Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- TitleBar with Window Controls -->
        <ui:TitleBar Grid.Row="0"
                     Title="ScrcpyDeX — Settings"
                     Icon="/icon.ico"
                     ShowMaximize="True"
                     ShowMinimize="True"
                     ShowClose="True">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#0078D4" CornerRadius="4" Padding="6,2" Margin="10,0,0,0">
                        <TextBlock Text="v1.1 Fluent" FontSize="10.5" FontWeight="Bold" Foreground="White" />
                    </Border>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Top Header Bar with Branding & Quick Actions -->
        <Border Grid.Row="1" Background="#1C1C1C" BorderBrush="#2C2C2C" BorderThickness="0,0,0,1" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Samsung DeX" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Direct PC Streaming" FontSize="20" FontWeight="Light" Foreground="#84B8F0" Margin="8,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="Direct USB desktop session with Linux /dev/uhid mouse capture"
                               FontSize="12" Foreground="#8C8C8C" Margin="0,3,0,0" />
                </StackPanel>

                <!-- Auto-Save Status Indicator -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:SymbolIcon Symbol="Checkmark24" FontSize="13" Foreground="#4CAF50" Margin="0,0,6,0" />
                    <TextBlock Text="Auto-saved" Foreground="#8E8E8E" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Prerequisite Warning Banner (scrcpy missing, etc.) -->
        <Border Grid.Row="2"
                Background="#3A2500"
                BorderBrush="#B8860B"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                Margin="24,12,24,0"
                Visibility="{Binding HasPrerequisiteWarning, Converter={StaticResource BoolToVisConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Warning24" FontSize="20" Foreground="#FFC107" Margin="0,0,12,0" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Prerequisite Warning" FontWeight="SemiBold" FontSize="13" Foreground="#FFD54F" />
                    <TextBlock Text="{Binding PrerequisiteWarning}" Foreground="#FFE082" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <ui:Button Appearance="Primary"
                               Command="{Binding BrowseScrcpyPathCommand}"
                               Height="32" Padding="12,0" Margin="0,0,8,0"
                               ToolTip="Configure custom scrcpy.exe path">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14" />
                            <TextBlock Text="Configure Path..." FontSize="12" FontWeight="SemiBold" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Appearance="Secondary"
                               Command="{Binding RefreshScrcpyCheckCommand}"
                               Height="32" Padding="10,0"
                               ToolTip="Refresh scrcpy detection status">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowSync24" Margin="0,0,4,0" FontSize="14" />
                            <TextBlock Text="Refresh" FontSize="12" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Navigation Tabs Container -->
        <TabControl Grid.Row="3"
                    Style="{StaticResource ModernTabControl}"
                    ItemContainerStyle="{StaticResource ModernTabItem}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}"
                    Margin="24,14,24,12">
            <!-- TAB 1: Display & Video -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Desktop24" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="Display &amp; Video" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="Video Stream &amp; Resolution Configuration" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Resolution Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Display Resolution" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Virtual display resolution exposed to One UI desktop compositor" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding Resolutions}" SelectedItem="{Binding Settings.Display.Resolution}" />
                        </ui:CardControl>

                        <!-- Refresh Rate (FPS) Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Target Refresh Rate (FPS)" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Frame rate cap for video stream (60 FPS default, 120 FPS high refresh)" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding FpsOptions}" SelectedItem="{Binding Settings.Display.Fps}" />
                        </ui:CardControl>

                        <!-- Video Bitrate Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Video Bitrate" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Target bandwidth allocation for compressed video stream (8 Mbps recommended)" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding BitrateOptions}" SelectedItem="{Binding Settings.Display.Bitrate}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Converter={StaticResource BitrateConverter}}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Video Codec Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Hardware Video Codec" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Compression format (H.264 offers low latency; H.265 provides higher compression)" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding CodecOptions}" SelectedItem="{Binding Settings.Display.Codec}" />
                        </ui:CardControl>

                        <!-- Window Mode Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Window Presentation Mode" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Viewport presentation style on host Windows desktop" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding WindowModeOptions}" SelectedItem="{Binding Settings.Display.WindowMode}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Audio & Input -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Speaker224" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="Audio &amp; Input" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="Audio Forwarding &amp; Input Capture" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Audio Toggle Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Forward Audio to PC" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Stream device audio in real-time to default Windows output speakers" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.Audio.Enabled}" />
                        </ui:CardControl>

                        <!-- Audio Buffer Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Audio Latency Buffer" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Audio buffer margin in milliseconds (50ms recommended to prevent buffer underruns)" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding AudioBufferOptions}" SelectedItem="{Binding Settings.Audio.BufferMs}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='{}{0} ms'}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </ui:CardControl>

                        <!-- Mouse Driver Subsystem Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Mouse Driver Subsystem" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="uhid: Linux /dev/uhid mode (recommended). sdk: Android injection mode." Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding MouseDriverOptions}" SelectedItem="{Binding Settings.Input.MouseDriver}" />
                        </ui:CardControl>

                        <!-- Release Key Shortcut Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Mouse Capture Release Key" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Keyboard key to unbind cursor focus and return mouse control to Windows desktop" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox Width="180" ItemsSource="{Binding ReleaseKeyOptions}" SelectedItem="{Binding Settings.Input.ReleaseKey}" />
                        </ui:CardControl>

                        <!-- Forward Gamepad Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Forward Gamepad Controllers" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Route Xbox, DualSense, and DirectInput gaming controllers directly into Samsung DeX games" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.Input.ForwardGamepad}" />
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Device & System -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Phone24" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="Device &amp; System" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="Device Power &amp; System Information" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Turn Screen Off Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Turn Physical Phone Screen Off" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Blanks physical OLED phone display while streaming DeX to conserve battery and avoid burn-in" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.Device.TurnScreenOff}" />
                        </ui:CardControl>

                        <!-- Stay Awake Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Stay Awake on USB" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Acquires Android power wakelock while connected to PC to prevent lock screen dropouts" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.Device.StayAwake}" />
                        </ui:CardControl>

                        <!-- Auto-Connect Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Auto-Connect on USB Insertion" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Automatically launches Samsung DeX session when authorized phone is plugged in" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch IsChecked="{Binding Settings.Device.AutoConnect}" />
                        </ui:CardControl>

                        <!-- Executable & System Paths Section -->
                        <TextBlock Text="Executable &amp; System Paths" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,12" />

                        <!-- scrcpy Executable Path Card -->
                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="scrcpy Executable Path" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Custom filesystem path to scrcpy.exe (leave empty for automatic detection)" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,4" />
                                    <TextBlock Text="{Binding ResolvedScrcpyStatusText}"
                                               FontSize="11.5"
                                               Foreground="{Binding ResolvedScrcpyStatusColor}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:TextBox Width="260"
                                            PlaceholderText="Auto-detected on system (leave empty)"
                                            Text="{Binding Settings.Paths.ScrcpyPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Height="32" Margin="0,0,8,0" />
                                <ui:Button Appearance="Secondary"
                                           Command="{Binding BrowseScrcpyPathCommand}"
                                           Height="32" Padding="12,0" Margin="0,0,6,0"
                                           ToolTip="Browse for scrcpy.exe file">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="FolderOpen24" Margin="0,0,6,0" FontSize="14" />
                                        <TextBlock Text="Browse..." FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                                <ui:Button Appearance="Secondary"
                                           Command="{Binding RefreshScrcpyCheckCommand}"
                                           Height="32" Padding="10,0" Margin="0,0,6,0"
                                           ToolTip="Re-scan and refresh scrcpy detection">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="14" />
                                </ui:Button>
                                <ui:Button Appearance="Secondary"
                                           Command="{Binding ResetScrcpyPathCommand}"
                                           Height="32" Padding="10,0"
                                           ToolTip="Reset path to automatic system discovery">
                                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="14" />
                                </ui:Button>
                            </StackPanel>
                        </ui:CardControl>

                        <!-- Telemetry Specs Box -->
                        <TextBlock Text="Connected Device Information" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,12" />

                        <Border Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="200" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!-- Model & Manufacturer -->
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Device Model / Vendor" Foreground="#9E9E9E" FontSize="13" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding CurrentDevice.Manufacturer, TargetNullValue='Samsung'}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                    <TextBlock Text=" " />
                                    <TextBlock Text="{Binding CurrentDevice.Model, TargetNullValue='No Device'}" FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF" />
                                </StackPanel>

                                <!-- Serial Number -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number" Foreground="#9E9E9E" FontSize="13" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CurrentDevice.Serial, TargetNullValue='Disconnected'}" FontFamily="Consolas" FontSize="13" Foreground="#B0B0B0" Margin="0,0,0,10" />

                                <!-- One UI & Android Version -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="OS / One UI Version" Foreground="#9E9E9E" FontSize="13" Margin="0,0,0,10" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding CurrentDevice.OneUiVersion, StringFormat='One UI {0}', TargetNullValue='One UI N/A'}" FontWeight="Medium" FontSize="13" Foreground="#84B8F0" />
                                    <TextBlock Text=" • " Foreground="#666666" />
                                    <TextBlock Text="{Binding CurrentDevice.AndroidVersion, StringFormat='Android {0}', TargetNullValue='Android N/A'}" FontSize="13" Foreground="#E0E0E0" />
                                </StackPanel>

                                <!-- DeX Virtual Display ID -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="DeX Virtual Display" Foreground="#9E9E9E" FontSize="13" />
                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                                    <Border Background="#1C3820" BorderBrush="#2E6B30" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding CurrentDevice.DeXDisplayId, StringFormat='Surface ID #{0}', TargetNullValue='Surface Pending'}" FontSize="11" FontWeight="Bold" Foreground="#84E184" />
                                    </Border>
                                    <TextBlock Text="Allocated via Android DisplayManager" FontSize="12" Foreground="#888888" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Configuration Management & Factory Reset Section -->
                        <TextBlock Text="Configuration Management" Style="{StaticResource SectionHeaderStyle}" Margin="0,18,0,12" />

                        <!-- Reset Defaults Card -->
                        <ui:CardControl Margin="0,0,0,12">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,2">
                                    <TextBlock Text="Restore Default Configuration" FontWeight="SemiBold" FontSize="13.5" />
                                    <TextBlock Text="Revert all display, audio, input, device, and path settings to initial factory defaults" Foreground="#9E9E9E" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:Button Appearance="Secondary"
                                       Command="{Binding ResetDefaultsCommand}"
                                       Height="34" Padding="16,0"
                                       ToolTip="Reset all configuration values to defaults">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowReset24" Margin="0,0,8,0" FontSize="14" />
                                    <TextBlock Text="Reset Defaults" FontSize="12.5" />
                                </StackPanel>
                            </ui:Button>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 4: Telemetry & Logs -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="SlideText24" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="Logs" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Minimal Logs Toolbar: Filter, Copy, Clear -->
                    <Border Grid.Row="0" Background="#202020" BorderBrush="#333333" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Filter -->
                            <ui:TextBox Grid.Column="0"
                                        PlaceholderText="Filter logs..."
                                        Text="{Binding LogSearchFilter, UpdateSourceTrigger=PropertyChanged}"
                                        Height="32"
                                        MaxWidth="340"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center">
                                <ui:TextBox.Icon>
                                    <ui:SymbolIcon Symbol="Search24" FontSize="14" Foreground="#888888" />
                                </ui:TextBox.Icon>
                            </ui:TextBox>

                            <!-- Copy and Clear -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:Button Appearance="Secondary"
                                           Command="{Binding CopyLogsCommand}"
                                           Height="32" Padding="14,0" Margin="0,0,8,0"
                                           ToolTip="Copy all logs to clipboard">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Copy24" Margin="0,0,6,0" FontSize="14" />
                                        <TextBlock Text="Copy" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Appearance="Secondary"
                                           Command="{Binding ClearLogsCommand}"
                                           Height="32" Padding="14,0"
                                           ToolTip="Clear log history">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" Margin="0,0,6,0" FontSize="14" />
                                        <TextBlock Text="Clear" FontSize="12" />
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Selectable Read-Only Log Console -->
                    <Border Grid.Row="1" Background="#0C0C0C" BorderBrush="#282828" BorderThickness="1" CornerRadius="8" Padding="10,8">
                        <RichTextBox x:Name="LogsRichTextBox"
                                     IsReadOnly="True"
                                     IsUndoEnabled="False"
                                     Background="Transparent"
                                     Foreground="#FFFFFF"
                                     BorderThickness="0"
                                     FontFamily="Cascadia Code, Consolas, Courier New, monospace"
                                     FontSize="12"
                                     Cursor="IBeam"
                                     VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto">
                            <RichTextBox.Resources>
                                <Style TargetType="{x:Type Paragraph}">
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="LineHeight" Value="18" />
                                </Style>
                            </RichTextBox.Resources>
                        </RichTextBox>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 5: About & Legal Disclaimers -->
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Info24" Margin="0,0,8,0" FontSize="16" />
                        <TextBlock Text="About &amp; Legal" VerticalAlignment="Center" />
                    </StackPanel>
                </TabItem.Header>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,12,12,0">
                    <StackPanel MaxWidth="880" HorizontalAlignment="Left">
                        <TextBlock Text="Legal Notices &amp; Licensing" Style="{StaticResource SectionHeaderStyle}" />

                        <!-- Project Identity Card -->
                        <ui:CardControl Margin="0,0,0,10">
                            <ui:CardControl.Header>
                                <StackPanel Margin="0,4">
                                    <TextBlock Text="ScrcpyDeX — Standalone Interoperability Tool" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" />
                                    <TextBlock Text="Version 1.1.0 (Fluent Windows Client) • Licensed under Apache License, Version 2.0" Foreground="#0078D4" FontWeight="SemiBold" FontSize="12.5" Margin="0,3,0,0" />
                                    <TextBlock Text="Copyright © 2026 Aureliano Peixoto and ScrcpyDeX Contributors." Foreground="#A0A0A0" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <!-- Trademark Disclaimer Card -->
                        <Border Background="#1C1C1C" BorderBrush="#2F2F2F" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Shield24" Margin="0,0,8,0" FontSize="16" Foreground="#FFB900" />
                                    <TextBlock Text="Notice of Non-Affiliation &amp; Trademark Disclaimers" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#B0B0B0" FontSize="12" LineHeight="18">
                                    <Run Text="• Samsung, Samsung DeX, Galaxy, and One UI are registered trademarks of Samsung Electronics Co., Ltd." /><LineBreak />
                                    <Run Text="• Android is a trademark of Google LLC. Windows is a registered trademark of Microsoft Corporation." /><LineBreak />
                                    <Run Text="• Genymobile and scrcpy are trademarks or registered marks of Genymobile." /><LineBreak /><LineBreak />
                                    <Run FontWeight="SemiBold" Foreground="#E0E0E0" Text="ScrcpyDeX is an independent, community-driven open-source project." />
                                    <Run Text=" ScrcpyDeX is NOT affiliated with, authorized by, sponsored by, or endorsed by Samsung Electronics Co., Ltd., Google LLC, Genymobile, Microsoft Corporation, or any of their affiliates or subsidiaries. Any reference to third-party trademarks is made strictly for descriptive and nominative fair use to describe hardware and system interoperability." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Statutory Interoperability Exemptions Card -->
                        <Border Background="#1C1C1C" BorderBrush="#2F2F2F" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="DocumentBulletList24" Margin="0,0,8,0" FontSize="16" Foreground="#0078D4" />
                                    <TextBlock Text="Interoperability Information" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#B0B0B0" FontSize="12" LineHeight="18">
                                    <Run Text="This software operates within established legal exemptions for software interoperability and clean-room implementation:" /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Text="United States:" /><Run Text=" 17 U.S.C. § 1201(f) (Reverse Engineering for Interoperability) &amp; Google v. Oracle, 141 S. Ct. 1183 (2021) (Fair Use of functional interfaces)." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Text="European Union:" /><Run Text=" Directive 2009/24/EC, Articles 5(3) &amp; 6 (Decompilation for Interoperability is mandatory and non-waivable)." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Text="Brazil:" /><Run Text=" Lei de Software nº 9.609/1998, Art. 6º, incisos I, III, IV e § 1º (Licitude da semelhança por requisitos funcionais e integração técnica indispensável)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Third-Party Open Source Attributions -->
                        <Border Background="#1C1C1C" BorderBrush="#2F2F2F" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <ui:SymbolIcon Symbol="Code24" Margin="0,0,8,0" FontSize="16" Foreground="#107C41" />
                                    <TextBlock Text="Third-Party Open Source Software Attributions" FontWeight="SemiBold" FontSize="13.5" Foreground="#FFFFFF" />
                                </StackPanel>
                                <TextBlock TextWrapping="Wrap" Foreground="#A0A0A0" FontSize="12" LineHeight="18">
                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="scrcpy:" /><Run Text=" Copyright © 2018–2024 Genymobile, Romain Vimont. Licensed under Apache 2.0." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="WPF-UI:" /><Run Text=" Copyright © 2021–2024 Lepoco, Leszek Pomian. Licensed under MIT License." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="CommunityToolkit.Mvvm:" /><Run Text=" Copyright © .NET Foundation and Contributors. Licensed under MIT License." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="System.Text.Json &amp; .NET 8:" /><Run Text=" Copyright © Microsoft Corporation. Licensed under MIT License." /><LineBreak />
                                    <Run Text="• " /><Run FontWeight="SemiBold" Foreground="#D0D0D0" Text="Android Robot Asset:" /><Run Text=" Portions reproduced or modified from work created and shared by Google (CC-BY 3.0)." />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Bottom Action Command Bar -->
        <Border Grid.Row="4" Background="#1E1E1E" BorderBrush="#2C2C2C" BorderThickness="0,1,0,0" Padding="24,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left: Device Indicator & Status -->
                    <ColumnDefinition Width="*" />
                    <!-- Right: Command Buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Device Connection Indicator & Session Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Dynamic Device Connection Pill -->
                    <Border CornerRadius="18" Padding="14,6" Margin="0,0,14,0"
                            Background="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Background}"
                            BorderBrush="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Border}"
                            BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- LED Glow Indicator -->
                            <Ellipse Width="10" Height="10" Margin="0,0,8,0"
                                     Fill="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Dot}" />
                            <TextBlock Text="{Binding DeviceStatusPillText}"
                                       FontWeight="SemiBold" FontSize="12.5"
                                       Foreground="{Binding DeviceStatusColor, Converter={StaticResource DeviceStatusBrushConverter}, ConverterParameter=Text}" />
                        </StackPanel>
                    </Border>

                    <!-- Session State & Subtitle -->
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusMessage}"
                                       FontWeight="SemiBold" FontSize="13" Foreground="#FFFFFF"
                                       TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <ui:Button Appearance="Danger"
                                       Command="{Binding GoToLogsCommand}"
                                       Visibility="{Binding ErrorLogCount, Converter={StaticResource CountToVisConverter}}"
                                       Height="22" Padding="6,0" Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       ToolTip="View diagnostic logs">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Warning16" FontSize="11" Margin="0,0,4,0" />
                                    <TextBlock Text="View Logs" FontSize="10.5" FontWeight="SemiBold" />
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                        <TextBlock Text="{Binding DeviceStatusDetails}"
                                   FontSize="11" Foreground="#8E8E8E" Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis" MaxWidth="420" />
                    </StackPanel>
                </StackPanel>

                <!-- Right: Big Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Big "Start Samsung DeX" Button -->
                    <ui:Button Appearance="Primary"
                               Command="{Binding StartDeXCommand}"
                               Visibility="{Binding IsIdle, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="22,0" Margin="0,0,10,0"
                               FontSize="13.5" FontWeight="SemiBold"
                               ToolTip="Start DeX desktop session on virtual display via scrcpy">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Play24" Margin="0,0,8,0" FontSize="16" />
                            <TextBlock Text="Start DeX Session" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- "Disconnect" Button -->
                    <ui:Button Appearance="Secondary"
                               Command="{Binding StopDeXCommand}"
                               Visibility="{Binding CanStop, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="18,0" Margin="0,0,10,0"
                               FontSize="13" FontWeight="Medium"
                               ToolTip="Stop streaming and release DeX display">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Stop24" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="Disconnect" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Emergency "Force Close" (Kill Switch) Button -->
                    <ui:Button Appearance="Danger"
                               Command="{Binding EmergencyKillCommand}"
                               Visibility="{Binding ShowForceCloseButton, Converter={StaticResource BoolToVisConverter}}"
                               Height="42" Padding="16,0"
                               FontSize="13" FontWeight="SemiBold"
                               ToolTip="Force Close: Terminate scrcpy and ADB processes">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Warning24" Margin="0,0,6,0" FontSize="16" />
                            <TextBlock Text="Force Close" VerticalAlignment="Center" />
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
