<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScrcpyDex.App.ViewModels"
        xmlns:models="using:ScrcpyDex.Models"
        xmlns:appModels="using:ScrcpyDex.App.Models"
        xmlns:loc="using:ScrcpyDex.Core.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="390"
        x:Class="ScrcpyDex.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationManager.Instance}}"
        Icon="avares://ScrcpyDex.App/Assets/app_icon.ico"
        Width="680" Height="390" MinWidth="680" MaxWidth="680" MinHeight="390" MaxHeight="390"
        CanResize="False"
        SystemDecorations="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        TransparencyLevelHint="AcrylicBlur"
        Background="Transparent"
        FontFamily="fonts:Inter#Inter, Inter, Segoe UI, sans-serif">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartSessionCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding StopSessionCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ToggleFaqCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CloseSettingsCommand}" />
    </Window.KeyBindings>

    <!-- Outer Translucent Charcoal Shell (#660E0E12, 14px Radius, #33333C Border — AudioEspacial Architecture) -->
    <Border Background="#660E0E12"
            BorderBrush="#33333C"
            BorderThickness="1"
            CornerRadius="14"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto, *">

            <!-- ========================================================================= -->
            <!-- 1. COMPACT PRECISION HEADER (DRAGGABLE)                                   -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Background="Transparent"
                    Padding="22,16,20,10"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="*, Auto" VerticalAlignment="Center">
                    <!-- Brand Micro-Label & Live Session Subtitle -->
                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="SCRCPYDEX"
                                   FontSize="10.5"
                                   FontWeight="SemiBold"
                                   LetterSpacing="0.8"
                                   Foreground="#86868B" />
                        <TextBlock Text="{Binding SessionStatusText}"
                                   FontSize="9.5"
                                   MaxWidth="390"
                                   TextTrimming="CharacterEllipsis"
                                   HorizontalAlignment="Left"
                                   Foreground="#777780" />
                    </StackPanel>

                    <!-- Status Pill + Settings + Minimize + Close -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <!-- Status Pill -->
                        <Border Background="#1B1B22"
                                BorderBrush="#33333C"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="9,5"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{Binding StatusBadgeColor}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StatusPillText}"
                                           FontSize="9"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.4"
                                           Foreground="#F5F5F7"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Settings Toggle Button -->
                        <Button Classes="circle-icon"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="{Binding [Window_Tooltip_Settings], Source={x:Static loc:LocalizationManager.Instance}}">
                            <PathIcon Data="{StaticResource Icon_Gear}"
                                      Width="12" Height="12"
                                      Foreground="#D0D0D7" />
                        </Button>

                        <!-- Minimize Window Button -->
                        <Button Classes="circle-icon"
                                Click="OnMinimizeButtonClick"
                                Content="—"
                                FontSize="11"
                                Foreground="#D0D0D7"
                                ToolTip.Tip="{Binding [Window_Tooltip_Minimize], Source={x:Static loc:LocalizationManager.Instance}}" />

                        <!-- Close Window Button -->
                        <Button Classes="circle-icon"
                                Click="OnCloseButtonClick"
                                Content="×"
                                FontSize="15"
                                Foreground="#D0D0D7"
                                ToolTip.Tip="{Binding [Window_Tooltip_Close], Source={x:Static loc:LocalizationManager.Instance}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========================================================================= -->
            <!-- 2. MAIN CONTENT AREA: DEVICE VIEW / SETTINGS / FAQ                        -->
            <!-- ========================================================================= -->
            <Grid Grid.Row="1" Margin="22,6,22,20">

                <!-- 2A. PRIMARY DEVICE VIEW (Photo on Left without divider, height locked to right column) -->
                <Grid IsVisible="{Binding IsMainDeviceViewVisible}"
                      ColumnDefinitions="Auto, *"
                      VerticalAlignment="Stretch">

                    <!-- LEFT COLUMN: Device Photo Only (Height stretched to match top of title to bottom of Telemetry) -->
                    <Grid Grid.Column="0"
                          VerticalAlignment="Stretch"
                          HorizontalAlignment="Center"
                          Margin="0,2,20,0">
                        <!-- Real Smartphone PNG Render -->
                        <Image Source="{Binding DeviceImage}"
                               Stretch="Uniform"
                               MaxWidth="260"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Stretch"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               IsVisible="{Binding HasDeviceImage}" />

                        <!-- Minimal Recessed Stage Frame Fallback (when no device PNG is loaded) -->
                        <Border Width="168"
                                Background="#121217"
                                BorderBrush="#2B2B33"
                                BorderThickness="1.5"
                                CornerRadius="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                IsVisible="{Binding HasDeviceImage, Converter={StaticResource InverseBooleanConverter}}">
                            <Grid RowDefinitions="Auto, *, Auto" Margin="12">
                                <Ellipse Grid.Row="0" Width="5" Height="5" Fill="#2B2B33" HorizontalAlignment="Center" Margin="0,2,0,0" />
                                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <PathIcon Data="{StaticResource Icon_Display}" Width="22" Height="22" Foreground="#FF7A00" />
                                    <TextBlock Text="{Binding DeviceFrameFallbackText}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.6"
                                               Foreground="#D0D0D7"
                                               HorizontalAlignment="Center" />
                                </StackPanel>
                                <Border Grid.Row="2" Width="36" Height="3" CornerRadius="1.5" Background="#2B2B33" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- RIGHT COLUMN: Device Title, Target Selector, Primary Actions & Telemetry Card -->
                    <Grid Grid.Column="1"
                          RowDefinitions="Auto, *, Auto, Auto"
                          VerticalAlignment="Stretch"
                          Margin="0,2,0,0">

                        <!-- Top: Device Title, Model Badges & Target Selector Dropdown -->
                        <StackPanel Grid.Row="0" Spacing="12">
                            <StackPanel Spacing="3">
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding DeviceDisplayName}"
                                               FontSize="20"
                                               FontWeight="SemiBold"
                                               Foreground="#F5F5F7"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                Spacing="5"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding HasSelectedDevice}">
                                        <Border Background="#1B1B22"
                                                BorderBrush="#33333C"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,3">
                                            <TextBlock Text="{Binding DeviceModelCode}"
                                                       FontSize="9.5"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       Foreground="#D0D0D7" />
                                        </Border>
                                        <Border Background="#26170A"
                                                BorderBrush="#FF7A00"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="7,3"
                                                IsVisible="{Binding IsMirroringMode}">
                                            <TextBlock Text="{Binding [Ui_Mirror], Source={x:Static loc:LocalizationManager.Instance}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       LetterSpacing="0.4"
                                                       Foreground="#FF9A3D" />
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="{Binding HardwareModelDisplay}"
                                           FontSize="11"
                                           Foreground="#86868B"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!-- Target Device Dropdown (Expands on Click) -->
                            <StackPanel Spacing="5">
                                <TextBlock Text="{Binding [Ui_TargetDevice], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           LetterSpacing="0.8"
                                           Foreground="#86868B" />
                                <ComboBox Classes="dex-combobox"
                                          ItemsSource="{Binding DeviceList}"
                                          SelectedItem="{Binding SelectedDevice}"
                                          HorizontalAlignment="Stretch"
                                          Height="34"
                                          FontSize="12"
                                          PlaceholderText="{Binding [DeviceSelector_NoDevicesPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:DeviceInfo">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding MarketingName}" FontWeight="SemiBold" Foreground="#F5F5F7" />
                                                <TextBlock Text="{Binding Serial, StringFormat='({0})'}" Foreground="#86868B" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>

                        <!-- Action Row: [START / STOP | SCAN] -->
                        <Grid Grid.Row="2"
                              ColumnDefinitions="*, 10, 108"
                              Height="44"
                              Margin="0,12,0,12">
                            <!-- Start Session Button (Orange #FF7A00) -->
                            <Button Grid.Column="0"
                                    Classes="btn-primary"
                                    Command="{Binding StartSessionCommand}"
                                    IsEnabled="{Binding CanStart}"
                                    IsVisible="{Binding !CanStop}"
                                    HorizontalAlignment="Stretch"
                                    Height="44">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Play}" Width="11" Height="11" Foreground="#F5F5F7" />
                                    <TextBlock Text="{Binding StartSessionButtonText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.3"
                                               Foreground="#F5F5F7" />
                                </StackPanel>
                            </Button>

                            <!-- Stop Session Button -->
                            <Button Grid.Column="0"
                                    Classes="btn-destructive"
                                    Command="{Binding StopSessionCommand}"
                                    IsEnabled="{Binding CanStop}"
                                    IsVisible="{Binding CanStop}"
                                    HorizontalAlignment="Stretch"
                                    Height="44">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Stop}" Width="11" Height="11" Foreground="#FF453A" />
                                    <TextBlock Text="{Binding [Action_StopSessionText], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.3"
                                               Foreground="#F5F5F7" />
                                </StackPanel>
                            </Button>

                            <!-- Scan Devices Button -->
                            <Button Grid.Column="2"
                                    Classes="btn-secondary"
                                    Command="{Binding RefreshDevicesCommand}"
                                    HorizontalAlignment="Stretch"
                                    Height="44"
                                    ToolTip.Tip="{Binding [DeviceSelector_RescanTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Refresh}" Width="12" Height="12" Foreground="#D0D0D7" />
                                    <TextBlock Text="{Binding [Action_Rescan], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.3"
                                               Foreground="#D0D0D7" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Single Subtle Telemetry Card (#16161C, Border #2B2B33, Radius 14 — AudioEspacial INPUT LEVELS Card Pattern) -->
                        <Border Grid.Row="3"
                                Background="#16161C"
                                BorderBrush="#2B2B33"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,13">
                            <StackPanel Spacing="10">
                                <!-- Card Header: TELEMETRY on Left, Active Mode on Right -->
                                <Grid ColumnDefinitions="*, Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding [Telemetry_Header], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8"
                                               Foreground="#86868B"
                                               VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding ModeIndicatorText}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.6"
                                               Foreground="#FF7A00"
                                               VerticalAlignment="Center" />
                                </Grid>

                                <!-- 4 Tabular Telemetry Columns (Edge-aligned with even flexible spacers) -->
                                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3">
                                        <TextBlock Text="{Binding [Telemetry_Battery], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.5"
                                                   Foreground="#86868B" />
                                        <TextBlock Text="{Binding BatteryLevel}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   FontFeatures="+tnum"
                                                   Foreground="#F5F5F7" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Spacing="3">
                                        <TextBlock Text="{Binding [Telemetry_Temperature], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.5"
                                                   Foreground="#86868B" />
                                        <TextBlock Text="{Binding BatteryTemperature}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   FontFeatures="+tnum"
                                                   Foreground="#F5F5F7" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4" Spacing="3">
                                        <TextBlock Text="{Binding [Telemetry_UsbLink], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.5"
                                                   Foreground="#86868B" />
                                        <TextBlock Text="{Binding UsbLinkSpeed}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   FontFeatures="+tnum"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="#F5F5F7" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="6" Spacing="3" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding [Telemetry_Latency], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="8.5"
                                                   FontWeight="SemiBold"
                                                   LetterSpacing="0.5"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#86868B" />
                                        <TextBlock Text="{Binding EstimatedLatencyMs}"
                                                   FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   FontFeatures="+tnum"
                                                   HorizontalAlignment="Right"
                                                   Foreground="#F5F5F7" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                    </Grid>
                </Grid>

                <!-- ========================================================================= -->
                <!-- 2B. INTERNAL SETTINGS SCREEN (Same Window Dimension, Scrollable Cards)    -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsSettingsOpen}"
                      RowDefinitions="Auto, *"
                      RowSpacing="8">

                    <!-- Settings Sub-Header: Back + Title on Left; Console & FAQ Triggers on Right -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="pill-button"
                                    Command="{Binding CloseSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Back}" Width="10" Height="10" Foreground="#D0D0D7" />
                                    <TextBlock Text="{Binding [Ui_Back], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="#D0D0D7" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding [Ui_Configuration], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.8"
                                       Foreground="#86868B"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <!-- Dedicated Console Window Trigger -->
                            <Button Classes="pill-button"
                                    Command="{Binding OpenConsoleWindowCommand}"
                                    ToolTip.Tip="{Binding [Ui_ConsoleTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Terminal}" Width="10" Height="10" Foreground="#FF7A00" />
                                    <TextBlock Text="{Binding [Ui_Console], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.4"
                                               Foreground="#F5F5F7" />
                                </StackPanel>
                            </Button>

                            <!-- FAQ & Diagnostics Sub-Screen Trigger -->
                            <Button Classes="pill-button"
                                    Command="{Binding OpenFaqFromSettingsCommand}"
                                    ToolTip.Tip="{Binding [Faq_Title], Source={x:Static loc:LocalizationManager.Instance}}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Help}" Width="10" Height="10" Foreground="#D0D0D7" />
                                    <TextBlock Text="{Binding [Ui_FaqDoctor], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9.5"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.4"
                                               Foreground="#D0D0D7" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Scrollable Settings Cards -->
                    <ScrollViewer Grid.Row="1"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,2">
                        <StackPanel Spacing="10">

                            <!-- CARD 1: DISPLAY & HARDWARE ENCODER -->
                            <Border Classes="glass-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding [Ui_DisplayEncoder], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8"
                                               Foreground="#86868B" />

                                    <!-- Resolution -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Display_ResolutionLabel], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableResolutions}"
                                                  SelectedItem="{Binding SelectedResolution}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Custom Width x Height (only visible when Resolution == Custom) -->
                                    <Grid ColumnDefinitions="*, 84, 12, 84"
                                          Height="28"
                                          IsVisible="{Binding IsCustomResolution}">
                                        <TextBlock Text="{Binding [Ui_CustomDimensions], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="10.5" Foreground="#86868B" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1" Text="{Binding CustomWidth}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="×" FontSize="11" Foreground="#86868B" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="3" Text="{Binding CustomHeight}" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                                    </Grid>

                                    <!-- Display Density (DPI) -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Ui_DisplayDensityDpi], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableDpi}"
                                                  SelectedItem="{Binding SelectedDpi}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Target Frame Rate -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Display_TargetFrameRate], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableFps}"
                                                  SelectedItem="{Binding SelectedFps}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Video Codec -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Display_VideoCodec], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableCodecs}"
                                                  SelectedItem="{Binding SelectedCodec}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Render Driver -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Display_RenderingDriver], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableRenderDrivers}"
                                                  SelectedItem="{Binding SelectedRenderDriver}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Bitrate -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Display_TransmissionBitrate], Source={x:Static loc:LocalizationManager.Instance}}"
                                                       FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" />
                                            <TextBlock Text="{Binding BitrateStatusHint}"
                                                       FontSize="8.5" Foreground="#86868B" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding BitratePresets}"
                                                  SelectedItem="{Binding SelectedBitratePreset}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 2: SESSION & INPUT OPTIONS -->
                            <Border Classes="glass-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding [Ui_SessionInput], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8"
                                               Foreground="#86868B" />

                                    <!-- Mouse / Input Mode Dropdown -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [Ui_MouseInputDriver], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableInputModes}"
                                                  SelectedItem="{Binding SelectedInputMode}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- Turn Screen Off -->
                                    <Grid ColumnDefinitions="*, Auto" Height="26">
                                        <TextBlock Text="{Binding [QuickOptions_TurnScreenOff], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding TurnScreenOff}" />
                                    </Grid>

                                    <!-- Forward Shortcuts -->
                                    <Grid ColumnDefinitions="*, Auto" Height="26">
                                        <TextBlock Text="{Binding [QuickOptions_ForwardShortcuts], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding ForwardShortcuts}" />
                                    </Grid>

                                    <!-- Stay Awake -->
                                    <Grid ColumnDefinitions="*, Auto" Height="26">
                                        <TextBlock Text="{Binding [QuickOptions_StayAwake], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding StayAwake}" />
                                    </Grid>

                                    <!-- Low Latency Audio -->
                                    <Grid ColumnDefinitions="*, Auto" Height="26">
                                        <TextBlock Text="{Binding [QuickOptions_LowLatencyAudio], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding LowLatencyAudio}" />
                                    </Grid>

                                    <!-- Fullscreen Window -->
                                    <Grid ColumnDefinitions="*, Auto" Height="26">
                                        <TextBlock Text="{Binding [Ui_LaunchFullscreen], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding Fullscreen}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- CARD 3: SYSTEM, LANGUAGE & BINARY PATHS -->
                            <Border Classes="glass-card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{Binding [Ui_SystemBinaries], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="9"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8"
                                               Foreground="#86868B" />

                                    <!-- Language Dropdown -->
                                    <Grid ColumnDefinitions="*, 180" Height="28">
                                        <TextBlock Text="{Binding [General_Language_Desc], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" VerticalAlignment="Center" />
                                        <ComboBox Grid.Column="1" Classes="dex-combobox"
                                                  ItemsSource="{Binding AvailableLanguageOptions}"
                                                  SelectedItem="{Binding SelectedLanguageOption}"
                                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                                    </Grid>

                                    <!-- scrcpy Binary Path -->
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Ui_ScrcpyExecutable], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" />
                                            <TextBlock Text="{Binding ScrcpyPathDisplay}"
                                                       FontSize="9"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       Foreground="#86868B"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="pill-button"
                                                Command="{Binding BrowseScrcpyPathCommand}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource Icon_Folder}" Width="10" Height="10" Foreground="#D0D0D7" />
                                                <TextBlock Text="{Binding [Ui_Browse], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D0D7" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <!-- adb Binary Path -->
                                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Ui_AdbExecutable], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="Medium" Foreground="#D0D0D7" />
                                            <TextBlock Text="{Binding AdbPathDisplay}"
                                                       FontSize="9"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       Foreground="#86868B"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Classes="pill-button"
                                                Command="{Binding BrowseAdbPathCommand}"
                                                VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                <PathIcon Data="{StaticResource Icon_Folder}" Width="10" Height="10" Foreground="#D0D0D7" />
                                                <TextBlock Text="{Binding [Ui_Browse], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" FontWeight="SemiBold" Foreground="#D0D0D7" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- ========================================================================= -->
                <!-- 2C. INTERNAL FAQ & ENVIRONMENT DOCTOR SUB-SCREEN (Same Window Dimension)  -->
                <!-- ========================================================================= -->
                <Grid IsVisible="{Binding IsFaqOpen}"
                      RowDefinitions="Auto, Auto, Auto, *"
                      RowSpacing="6">

                    <!-- Sub-Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="pill-button"
                                    Command="{Binding OpenSettingsCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Back}" Width="10" Height="10" Foreground="#D0D0D7" />
                                    <TextBlock Text="{Binding [Ui_Settings], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" FontWeight="SemiBold" LetterSpacing="0.5" Foreground="#D0D0D7" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="{Binding [Ui_FaqDiagnostics], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       LetterSpacing="0.8"
                                       Foreground="#86868B"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <Button Grid.Column="2"
                                Classes="pill-button"
                                Command="{Binding RunDoctorCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Refresh}" Width="10" Height="10" Foreground="#FF7A00" />
                                <TextBlock Text="{Binding [Ui_CheckEnv], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9.5" FontWeight="SemiBold" Foreground="#F5F5F7" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Doctor Summary & Search Row -->
                    <Grid Grid.Row="1" ColumnDefinitions="*, 180" ColumnSpacing="8">
                        <Border Grid.Column="0"
                                Background="#16161C"
                                BorderBrush="#2B2B33"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="10,5">
                            <TextBlock Text="{Binding DoctorSummaryText}"
                                       FontSize="10"
                                       Foreground="#D0D0D7"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FaqSearchQuery, Mode=TwoWay}"
                                 Watermark="{Binding [Faq_SearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                                 FontSize="10.5" />
                    </Grid>

                    <!-- Category Filter Pills -->
                    <ItemsControl Grid.Row="2" ItemsSource="{Binding FaqCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="appModels:FaqCategoryItem">
                                <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFaqCategoryCommand}"
                                        CommandParameter="{Binding Id}"
                                        Padding="8,3"
                                        Margin="0,0,5,4"
                                        FontSize="9.5"
                                        FontWeight="SemiBold"
                                        CornerRadius="10"
                                        BorderThickness="1"
                                        Background="{Binding BackgroundBrush}"
                                        BorderBrush="{Binding BorderBrushColor}"
                                        Foreground="{Binding ForegroundBrush}"
                                        Content="{Binding HeaderText}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Scrollable FAQ Accordion List -->
                    <ScrollViewer Grid.Row="3"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="0,0,6,2">
                        <ItemsControl ItemsSource="{Binding FilteredFaqItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="appModels:FaqItem">
                                    <Border Background="#16161C"
                                            BorderBrush="#2B2B33"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Margin="0,0,0,6">
                                        <StackPanel>
                                            <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFaqItemExpandedCommand}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Padding="10,7"
                                                    CornerRadius="10">
                                                <Grid ColumnDefinitions="Auto, *, Auto">
                                                    <Border Grid.Column="0"
                                                            Background="#24242C"
                                                            CornerRadius="5"
                                                            Padding="5,2"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding CategoryName}"
                                                                   FontSize="8.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#86868B" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Title}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F5F5F7"
                                                               TextWrapping="Wrap"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ExpandIcon}"
                                                               FontSize="10"
                                                               Foreground="#86868B"
                                                               VerticalAlignment="Center" />
                                                </Grid>
                                            </Button>

                                            <Border IsVisible="{Binding IsExpanded}"
                                                    BorderBrush="#24242C"
                                                    BorderThickness="0,1,0,0"
                                                    Padding="10,8"
                                                    Background="#111115"
                                                    CornerRadius="0,0,10,10">
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Symptom}" FontSize="10.5" Foreground="#86868B" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Solution}" FontSize="10.5" Foreground="#D0D0D7" TextWrapping="Wrap" />
                                                    <Border IsVisible="{Binding HasCommand}"
                                                            Background="#16161C"
                                                            BorderBrush="#2B2B33"
                                                            BorderThickness="1"
                                                            CornerRadius="7"
                                                            Padding="8,5">
                                                        <Grid ColumnDefinitions="*, Auto">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding CommandCode}"
                                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                                       FontSize="9.5"
                                                                       Foreground="#FF9A3D"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center" />
                                                            <Button Grid.Column="1"
                                                                    Classes="pill-button"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyFaqCommandTextCommand}"
                                                                    CommandParameter="{Binding CommandCode}"
                                                                    Height="22"
                                                                    Padding="8,0"
                                                                    Margin="8,0,0,0">
                                                                <TextBlock Text="{Binding [Ui_Copy], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="8.5" FontWeight="SemiBold" Foreground="#F5F5F7" />
                                                            </Button>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </Grid>

            <!-- ========================================================================= -->
            <!-- 3. FULL-WINDOW CRITICAL ERROR OVERLAY (Dark Translucent Backdrop)         -->
            <!-- ========================================================================= -->
            <Border Grid.Row="0"
                    Grid.RowSpan="2"
                    ZIndex="200"
                    Background="#E60C0C10"
                    CornerRadius="14"
                    Padding="24"
                    IsVisible="{Binding IsCriticalErrorOverlayVisible}"
                    PointerPressed="OnTitleBarPointerPressed">
                <Border Background="#16161C"
                        BorderBrush="#35353E"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="20,18"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center">
                    <StackPanel Spacing="12">
                        <!-- Critical Alert Header -->
                        <Grid ColumnDefinitions="Auto, *, Auto">
                            <Border Grid.Column="0"
                                    Background="#2A1616"
                                    BorderBrush="#FF453A"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8,3"
                                    VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Alert}" Width="10" Height="10" Foreground="#FF453A" />
                                    <TextBlock Text="{Binding [Ui_CriticalAlert], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="8.5"
                                               FontWeight="SemiBold"
                                               LetterSpacing="0.8"
                                               Foreground="#FF453A" />
                                </StackPanel>
                            </Border>

                            <Button Grid.Column="2"
                                    Classes="circle-icon"
                                    Click="OnCloseButtonClick"
                                    Content="×"
                                    FontSize="15"
                                    Foreground="#D0D0D7"
                                    ToolTip.Tip="{Binding [Window_Tooltip_Close], Source={x:Static loc:LocalizationManager.Instance}}" />
                        </Grid>

                        <!-- Error Title & Detailed Description -->
                        <StackPanel Spacing="5">
                            <TextBlock Text="{Binding CriticalErrorTitle}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="#F5F5F7"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CriticalErrorDescription}"
                                       FontSize="11.5"
                                       Foreground="#A0A0A8"
                                       TextWrapping="Wrap"
                                       MaxHeight="90" />
                        </StackPanel>

                        <!-- Direct Resolution Action Buttons -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Classes="btn-primary"
                                    Command="{Binding BrowseScrcpyPathCommand}"
                                    IsVisible="{Binding !IsScrcpyDetected}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding [Ui_LocateScrcpy], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#F5F5F7" />
                            </Button>

                            <Button Classes="btn-primary"
                                    Command="{Binding BrowseAdbPathCommand}"
                                    IsVisible="{Binding !IsAdbDetected}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding [Ui_LocateAdb], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#F5F5F7" />
                            </Button>

                            <Button Classes="btn-secondary"
                                    Command="{Binding RevalidateEnvironmentCommand}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding [Ui_Retry], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#D0D0D7" />
                            </Button>

                            <Button Classes="btn-secondary"
                                    Command="{Binding OpenSettingsFromErrorCommand}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding [Ui_Settings], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#D0D0D7" />
                            </Button>

                            <Button Classes="btn-secondary"
                                    Command="{Binding OpenConsoleWindowCommand}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,6,6">
                                <TextBlock Text="{Binding [Ui_Console], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#D0D0D7" />
                            </Button>

                            <Button Classes="btn-secondary"
                                    Command="{Binding DismissCriticalErrorCommand}"
                                    Height="32"
                                    Padding="12,0"
                                    Margin="0,0,0,6">
                                <TextBlock Text="{Binding [Ui_Dismiss], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" FontWeight="SemiBold" Foreground="#86868B" />
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Border>

        </Grid>
    </Border>
</Window>
