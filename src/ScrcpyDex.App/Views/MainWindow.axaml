<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ScrcpyDex.App.ViewModels"
        xmlns:models="using:ScrcpyDex.Models"
        xmlns:appModels="using:ScrcpyDex.App.Models"
        xmlns:io="using:ScrcpyDex.Core.IO"
        xmlns:loc="using:ScrcpyDex.Core.Localization"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="940" d:DesignHeight="590"
        x:Class="ScrcpyDex.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding [MainWindow_Title], Source={x:Static loc:LocalizationManager.Instance}}"
        Icon="avares://ScrcpyDex.App/Assets/app_icon.ico"
        Width="940" Height="590"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="40"
        TransparencyLevelHint="Mica, AcrylicBlur"
        Background="Transparent"
        FontFamily="Segoe UI, Inter, -apple-system, BlinkMacSystemFont, sans-serif">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+Enter" Command="{Binding StartSessionCommand}" />
        <KeyBinding Gesture="Ctrl+Shift+W" Command="{Binding StopSessionCommand}" />
        <KeyBinding Gesture="F1" Command="{Binding ToggleFaqCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding CloseFaqCommand}" />
    </Window.KeyBindings>

    <Panel Background="#55121215">
        <Grid RowDefinitions="40, *">

            <!-- 1. INTEGRATED TITLEBAR -->
            <Border Grid.Row="0"
                    Background="#18181B20"
                    BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="16,0"
                    PointerPressed="OnTitleBarPointerPressed">
                <Grid ColumnDefinitions="Auto, *, Auto" Background="Transparent" PointerPressed="OnTitleBarPointerPressed">
                    
                    <!-- Left: Brand Identity & Toolbar Actions -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- App Icon -->
                        <Image Source="avares://ScrcpyDex.App/Assets/app_icon.png"
                               Width="20" Height="20"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapInterpolationMode="HighQuality" />

                        <TextBlock Text="ScrcpyDeX"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                   VerticalAlignment="Center" />

                        <!-- Version Badge -->
                        <Border Background="#2A2A2E" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="v2.0.0"
                                       FontSize="10"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                        </Border>

                        <Rectangle Width="1" Height="14" Fill="{StaticResource ThemeDividerBrush}" Margin="6,0" />

                        <!-- Language Picker (Pull-down Menu on Left) -->
                        <Button Classes="toolbar-button" ToolTip.Tip="{Binding [General_Language_Desc], Source={x:Static loc:LocalizationManager.Instance}}">
                            <Button.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="English (EN)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="en" />
                                    <MenuItem Header="Português (Brasil)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="pt-BR" />
                                    <MenuItem Header="Español (ES)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="es" />
                                    <MenuItem Header="Français (FR)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="fr" />
                                    <MenuItem Header="Deutsch (DE)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="de" />
                                    <MenuItem Header="简体中文 (ZH)"
                                              Command="{Binding ChangeLanguageCommand}"
                                              CommandParameter="zh-Hans" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Globe}" Width="12" Height="12" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                <TextBlock Text="{Binding CurrentLanguageCode}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                <TextBlock Text="▾" FontSize="9" Opacity="0.6" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Help & FAQ Drawer Trigger -->
                        <Button Classes="toolbar-button"
                                Command="{Binding ToggleFaqCommand}"
                                ToolTip.Tip="{Binding [Faq_Title], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Help}" Width="12" Height="12" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                <TextBlock Text="FAQ" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                            </StackPanel>
                        </Button>

                        <!-- Configure Scrcpy Binary Path -->
                        <Button Classes="toolbar-button"
                                Command="{Binding BrowseScrcpyPathCommand}"
                                ToolTip.Tip="{Binding [Action_ConfigureScrcpyTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <PathIcon Data="{StaticResource Icon_Gear}" Width="11" Height="11" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                <TextBlock Text="Scrcpy" FontSize="11" FontWeight="Medium" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right Column: Kept clear for native OS caption buttons -->
                </Grid>
            </Border>

            <!-- 2. MAIN CONTENT AREA: TWO-PANE STREAMLINED LAYOUT -->
            <Grid Grid.Row="1"
                  Margin="16,12,16,14"
                  ColumnDefinitions="300, 14, *"
                  VerticalAlignment="Stretch">

                <!-- CARD 1: CONNECTED DEVICE (HEADER INSIDE CARD, FULL HEIGHT TO WINDOW BOTTOM) -->
                <Border Grid.Column="0"
                        Classes="glass-card"
                        VerticalAlignment="Stretch">
                    <Grid RowDefinitions="Auto, Auto, Auto, Auto, Auto, *, Auto">

                        <!-- Row 0: Integrated Header INSIDE Card -->
                        <StackPanel Grid.Row="0" Spacing="6" Margin="0,0,0,6">
                            <TextBlock Text="{Binding [DeviceSelector_Header], Source={x:Static loc:LocalizationManager.Instance}}"
                                       FontSize="9.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                       Margin="2,0,0,0" />
                            <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" />
                        </StackPanel>

                        <!-- Row 1: Top Sub-Region: Device Info on Left, Smartphone Render on Right -->
                        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Height="124" Margin="0,0,0,6">
                            
                            <!-- Left side: Device Name, Model, Dropdown & Status Badge -->
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="5" Margin="0,0,8,0">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding DeviceDisplayName}"
                                               FontSize="14.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    
                                    <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasSelectedDevice}">
                                        <Border Background="#2A2A2E" CornerRadius="4" Padding="5,1">
                                            <TextBlock Text="{Binding DeviceModelCode}"
                                                       FontSize="9.5"
                                                       FontFamily="Cascadia Code, Consolas, monospace"
                                                       Foreground="{StaticResource ThemeAccentBlueHoverBrush}" />
                                        </Border>
                                        <Border Background="#2D2214" CornerRadius="4" Padding="5,1"
                                                IsVisible="{Binding IsMirroringMode}">
                                            <TextBlock Text="{Binding [Device_NonDexNotice], Source={x:Static loc:LocalizationManager.Instance}}"
                                                       FontSize="9"
                                                       FontWeight="SemiBold"
                                                       Foreground="#F59E0B" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Target Device Selector Dropdown -->
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding [DeviceSelector_TargetLabel], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="10"
                                               FontWeight="Medium"
                                               Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    <ComboBox Classes="dex-combobox"
                                              ItemsSource="{Binding DeviceList}"
                                              SelectedItem="{Binding SelectedDevice}"
                                              HorizontalAlignment="Stretch"
                                              Height="26"
                                              PlaceholderText="{Binding [DeviceSelector_NoDevicesPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:DeviceInfo">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="{Binding Model}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Serial, StringFormat='({0})'}" Foreground="{StaticResource ThemeLabelTertiaryBrush}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>

                                <!-- Live Status Badge -->
                                <Border Background="#1C3822"
                                        BorderBrush="#256B34"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="6,2"
                                        HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource ThemeSystemGreenBrush}" />
                                        <TextBlock Text="{Binding SessionStatusText}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ThemeSystemGreenBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="140" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Right side: Real Smartphone Render or Fallback Graphical Frame -->
                            <Grid Grid.Column="1" Width="100" Height="124" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <!-- Real Image -->
                                <Image Source="{Binding DeviceImage}"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       RenderOptions.BitmapInterpolationMode="HighQuality"
                                       IsVisible="{Binding HasDeviceImage}" />

                                <!-- Fallback Graphical Frame -->
                                <Border Width="76" Height="115"
                                        Background="#121214"
                                        BorderBrush="#38383C"
                                        BorderThickness="1.5"
                                        CornerRadius="13"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsVisible="{Binding HasDeviceImage, Converter={StaticResource InverseBooleanConverter}}">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="4">
                                        <PathIcon Data="{StaticResource Icon_Display}" Width="20" Height="20" Foreground="{StaticResource ThemeAccentBlueBrush}" />
                                        <TextBlock Text="{Binding DeviceFrameFallbackText}" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>

                        <!-- Row 2: Primary & Secondary Action Buttons -->
                        <StackPanel Grid.Row="2" Spacing="6" Margin="0,0,0,6">
                            <!-- Primary Start Session Button -->
                            <Button Classes="btn-primary"
                                    Command="{Binding StartSessionCommand}"
                                    IsEnabled="{Binding CanStart}"
                                    IsVisible="{Binding !CanStop}"
                                    HorizontalAlignment="Stretch"
                                    Height="30">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Play}" Width="10" Height="10" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding StartSessionButtonText}" FontWeight="SemiBold" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Destructive Stop Session Button -->
                            <Button Classes="btn-destructive"
                                    Command="{Binding StopSessionCommand}"
                                    IsEnabled="{Binding CanStop}"
                                    IsVisible="{Binding CanStop}"
                                    HorizontalAlignment="Stretch"
                                    Height="30">
                                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                                    <PathIcon Data="{StaticResource Icon_Stop}" Width="10" Height="10" Foreground="#FFFFFF" />
                                    <TextBlock Text="{Binding [Action_StopSessionText], Source={x:Static loc:LocalizationManager.Instance}}" FontWeight="SemiBold" FontSize="11.5" />
                                </StackPanel>
                            </Button>

                            <!-- Secondary Actions: Rescan & Logs (Side-by-side) -->
                            <Grid ColumnDefinitions="*, 8, *">
                                <Button Grid.Column="0"
                                        Classes="btn-secondary"
                                        Command="{Binding RefreshDevicesCommand}"
                                        HorizontalAlignment="Stretch"
                                        Height="26"
                                        ToolTip.Tip="{Binding [DeviceSelector_RescanTooltip], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Refresh}" Width="10" Height="10" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [Action_Rescan], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" />
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="2"
                                        Classes="btn-secondary"
                                        Command="{Binding ToggleLogInspectorCommand}"
                                        HorizontalAlignment="Stretch"
                                        Height="26"
                                        ToolTip.Tip="Toggle execution logs inspector">
                                    <StackPanel Orientation="Horizontal" Spacing="5" HorizontalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Terminal}" Width="10" Height="10" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                        <TextBlock Text="Logs" FontSize="11" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Row 3: Divider -->
                        <Rectangle Grid.Row="3" Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="0,2,0,6" />

                        <!-- Row 4: Telemetry Header -->
                        <TextBlock Grid.Row="4"
                                   Text="{Binding [Telemetry_Header], Source={x:Static loc:LocalizationManager.Instance}}"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                   Margin="2,0,0,6" />

                        <!-- Row 5: 4 Telemetry Rows (Stacked Vertically, filling down to the footer) -->
                        <Grid Grid.Row="5" RowDefinitions="*, 6, *, 6, *, 6, *" VerticalAlignment="Stretch">
                            <!-- Battery -->
                            <Border Grid.Row="0" CornerRadius="8" Background="#251E1E22" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="10,0">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1C3822" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Battery}" Width="12" Height="12" Foreground="{StaticResource ThemeSystemGreenBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="1">
                                        <TextBlock Text="{Binding [Telemetry_Battery], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Charge status" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding BatteryLevel}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeSystemGreenBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Temperature -->
                            <Border Grid.Row="2" CornerRadius="8" Background="#251E1E22" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="10,0">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#38281C" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Thermometer}" Width="12" Height="12" Foreground="{StaticResource ThemeSystemOrangeBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="1">
                                        <TextBlock Text="{Binding [Telemetry_Temperature], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Internal SoC" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding BatteryTemperature}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeSystemOrangeBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Link Speed -->
                            <Border Grid.Row="4" CornerRadius="8" Background="#251E1E22" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="10,0">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1C2E38" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Link}" Width="12" Height="12" Foreground="{StaticResource ThemeAccentBlueBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="1">
                                        <TextBlock Text="{Binding [Telemetry_Link], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Host connection" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding UsbLinkSpeed}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeAccentBlueHoverBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                </Grid>
                            </Border>

                            <!-- Latency -->
                            <Border Grid.Row="6" CornerRadius="8" Background="#251E1E22" BorderBrush="#1CFFFFFF" BorderThickness="1" Padding="10,0">
                                <Grid ColumnDefinitions="Auto, *, Auto" VerticalAlignment="Center">
                                    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="6" Background="#1C3538" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Latency}" Width="12" Height="12" Foreground="{StaticResource ThemeSystemTealBrush}" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0" Spacing="1">
                                        <TextBlock Text="{Binding [Telemetry_Latency], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Pipeline latency" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding EstimatedLatencyMs}" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource ThemeSystemTealBrush}" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Row 6: Hardware Model Footer -->
                        <TextBlock Grid.Row="6"
                                   Text="{Binding HardwareModelDisplay}"
                                   FontSize="9.5"
                                   Foreground="{StaticResource ThemeLabelTertiaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,8,0,0" />

                    </Grid>
                </Border>

                <!-- RIGHT AREA: CARDS 2 & 3 AND EXPANDED CONSOLE (ALIGNED FLUSH AT TOP AND BOTTOM) -->
                <Grid Grid.Column="2" RowDefinitions="Auto, 10, *" VerticalAlignment="Stretch">
                    
                    <!-- TWO-COLUMN GROUPED CARDS: DISPLAY & SESSION OPTIONS (ROW 0) -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, 12, *">

                        <!-- CARD 2: DISPLAY & HARDWARE ENCODER (HEADER INSIDE CARD, 100% FLUSH AT TOP) -->
                        <Border Grid.Column="0"
                                Classes="glass-card">
                            <StackPanel Spacing="8">
                                <!-- Integrated Header INSIDE Card -->
                                <TextBlock Text="{Binding [Display_CardHeader], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                           Margin="2,0,0,0" />
                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" />

                                <!-- Row 1: Resolution -->
                                <Grid Height="40" ColumnDefinitions="Auto, *, Auto" Margin="2,0">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource ThemeAccentBlueBrush}" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Display}" Width="11" Height="11" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [Display_ResolutionLabel], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Monitor canvas" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="dex-combobox" ItemsSource="{Binding AvailableResolutions}" SelectedItem="{Binding SelectedResolution}" Width="135" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="34,0,0,0" />

                                <!-- Row 2: Target Frame Rate -->
                                <Grid Height="40" ColumnDefinitions="Auto, *, Auto" Margin="2,0">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource ThemeSystemOrangeBrush}" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_FrameRate}" Width="11" Height="11" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [Display_TargetFrameRate], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Refresh cadence" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="dex-combobox" ItemsSource="{Binding AvailableFps}" SelectedItem="{Binding SelectedFps}" Width="135" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="34,0,0,0" />

                                <!-- Row 3: Video Codec -->
                                <Grid Height="40" ColumnDefinitions="Auto, *, Auto" Margin="2,0">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource ThemeSystemPurpleBrush}" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Codec}" Width="11" Height="11" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [Display_VideoCodec], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="Hardware profile" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="dex-combobox" ItemsSource="{Binding AvailableCodecs}" SelectedItem="{Binding SelectedCodec}" Width="135" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="34,0,0,0" />

                                <!-- Row 4: Render Driver -->
                                <Grid Height="40" ColumnDefinitions="Auto, *, Auto" Margin="2,0">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource ThemeSystemTealBrush}" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Driver}" Width="11" Height="11" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [Display_RenderingDriver], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="GPU pipeline" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="dex-combobox" ItemsSource="{Binding AvailableRenderDrivers}" SelectedItem="{Binding SelectedRenderDriver}" Width="135" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="34,0,0,0" />

                                <!-- Row 5: Transmission Bitrate -->
                                <Grid Height="40" ColumnDefinitions="Auto, *, Auto" Margin="2,0">
                                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="6" Background="{StaticResource ThemeSystemGreenBrush}" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Bitrate}" Width="11" Height="11" Foreground="#FFFFFF" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0" VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [Display_TransmissionBitrate], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding BitrateStatusHint}" FontSize="8.5" Foreground="{StaticResource ThemeLabelSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                    </StackPanel>
                                    <ComboBox Grid.Column="2" Classes="dex-combobox" ItemsSource="{Binding BitratePresets}" SelectedItem="{Binding SelectedBitratePreset}" Width="135" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- CARD 3: SESSION OPTIONS & INTEGRATION (HEADER INSIDE CARD, 100% FLUSH AT TOP) -->
                        <Border Grid.Column="2"
                                Classes="glass-card">
                            <StackPanel Spacing="8">
                                <!-- Integrated Header INSIDE Card -->
                                <TextBlock Text="{Binding [QuickOptions_Header], Source={x:Static loc:LocalizationManager.Instance}}"
                                           FontSize="9.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                           Margin="2,0,0,0" />
                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" />

                                <!-- Row 1: Screen Off -->
                                <Grid Height="40" ColumnDefinitions="*, Auto" Margin="4,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [QuickOptions_TurnScreenOff], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [QuickOptions_TurnScreenOff_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding TurnScreenOff}" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="4,0,0,0" />

                                <!-- Row 2: UHID Mouse -->
                                <Grid Height="40" ColumnDefinitions="*, Auto" Margin="4,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [QuickOptions_NativeUhidMouse], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [QuickOptions_NativeUhidMouse_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding MouseUhidEnabled}" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="4,0,0,0" />

                                <!-- Row 3: Forward Shortcuts -->
                                <Grid Height="40" ColumnDefinitions="*, Auto" Margin="4,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [QuickOptions_ForwardShortcuts], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [QuickOptions_ForwardShortcuts_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding ForwardShortcuts}" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="4,0,0,0" />

                                <!-- Row 4: Stay Awake -->
                                <Grid Height="40" ColumnDefinitions="*, Auto" Margin="4,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [QuickOptions_StayAwake], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [QuickOptions_StayAwake_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding StayAwake}" VerticalAlignment="Center" />
                                </Grid>

                                <Rectangle Height="1" Fill="{StaticResource ThemeDividerBrush}" Margin="4,0,0,0" />

                                <!-- Row 5: Low Latency Audio -->
                                <Grid Height="40" ColumnDefinitions="*, Auto" Margin="4,0">
                                    <StackPanel VerticalAlignment="Center" Spacing="1">
                                        <TextBlock Text="{Binding [QuickOptions_LowLatencyAudio], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelPrimaryBrush}" />
                                        <TextBlock Text="{Binding [QuickOptions_LowLatencyAudio_Desc], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="9" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>
                                    <ToggleSwitch Grid.Column="1" Classes="dex-switch" IsChecked="{Binding LowLatencyAudio}" VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- EXECUTION CONSOLE INSPECTOR (EXPANDS TO FILL REMAINING HEIGHT AND ALIGN WITH CARD 1 AT BOTTOM) -->
                    <Border Grid.Row="2"
                            Classes="glass-card"
                            ClipToBounds="True"
                            VerticalAlignment="Stretch"
                            IsVisible="{Binding IsLogExpanded}"
                            Padding="0">
                        <Grid RowDefinitions="28, *">
                            <!-- Inspector Sub-Header -->
                            <Border Grid.Row="0"
                                    Background="#E61A1A1D"
                                    BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                    BorderThickness="0,0,0,1"
                                    Padding="12,0">
                                <Grid ColumnDefinitions="Auto, *, Auto">
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <PathIcon Data="{StaticResource Icon_Terminal}" Width="11" Height="11" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                        <TextBlock Text="{Binding [Console_Header], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Classes="btn-secondary"
                                                Height="20"
                                                Padding="8,0"
                                                Command="{Binding CopyCliCommandCommand}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Console_CopyCli], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" />
                                        </Button>

                                        <Button Classes="btn-secondary"
                                                Height="20"
                                                Padding="8,0"
                                                Command="{Binding CopyTerminalLogsCommand}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Console_CopyLogs], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" />
                                        </Button>

                                        <Button Classes="btn-secondary"
                                                Height="20"
                                                Padding="8,0"
                                                Command="{Binding ClearLogsCommand}"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding [Action_Clear], Source={x:Static loc:LocalizationManager.Instance}}" FontSize="10" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Terminal Content Stream -->
                            <ScrollViewer x:Name="TerminalScrollViewer"
                                          Grid.Row="1"
                                          Padding="12,8,12,20"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock x:Name="TerminalTextBlock"
                                                     FontFamily="Cascadia Code, Consolas, monospace"
                                                     FontSize="10"
                                                     TextWrapping="Wrap"
                                                     Background="Transparent"
                                                     SelectionBrush="#2563EB"
                                                     Margin="0,0,0,12">
                                    <SelectableTextBlock.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [Console_CopyLogs], Source={x:Static loc:LocalizationManager.Instance}}"
                                                      Command="{Binding CopyTerminalLogsCommand}" />
                                            <MenuItem Header="{Binding [Console_CopyCli], Source={x:Static loc:LocalizationManager.Instance}}"
                                                      Command="{Binding CopyCliCommandCommand}" />
                                            <Separator />
                                            <MenuItem Header="{Binding [Action_Clear], Source={x:Static loc:LocalizationManager.Instance}}"
                                                      Command="{Binding ClearLogsCommand}" />
                                        </ContextMenu>
                                    </SelectableTextBlock.ContextMenu>
                                </SelectableTextBlock>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>

            <!-- 3. FAQ MODAL DIALOG OVERLAY (CENTERED OVER WINDOW CONTENT WITH DARK FROSTED BACKDROP) -->
            <Grid Grid.Row="0"
                  Grid.RowSpan="2"
                  IsVisible="{Binding IsFaqOpen}"
                  ZIndex="100">

                <!-- Dark Frosted Backdrop (Dims background, provides depth, clicking outside closes dialog) -->
                <Button Command="{Binding CloseFaqCommand}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Background="#B80A0D14"
                        BorderThickness="0"
                        Padding="0"
                        Margin="0">
                    <Button.Template>
                        <ControlTemplate>
                            <Border Background="{TemplateBinding Background}" />
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Centered Modal Dialog Card (Window-in-a-Window) -->
                <Border Width="680"
                        Height="470"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        CornerRadius="14"
                        Background="#F51A1A1F"
                        BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                        BorderThickness="1"
                        BoxShadow="0 24 64 0 #90000000, 0 4 16 0 #50000000"
                        ClipToBounds="True">
                    <Grid RowDefinitions="44, Auto, Auto, *">

                        <!-- 1. Modal Dialog Header -->
                        <Border Grid.Row="0"
                                Background="#E6202026"
                                BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="16,0">
                            <Grid ColumnDefinitions="Auto, *, Auto">
                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource ThemeAccentBlueBrush}">
                                        <PathIcon Data="{StaticResource Icon_Help}" Width="12" Height="12" Foreground="#FFFFFF" />
                                    </Border>
                                    <TextBlock Text="{Binding [Faq_Title], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="•" Foreground="{StaticResource ThemeLabelTertiaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding [Faq_Subtitle], Source={x:Static loc:LocalizationManager.Instance}}"
                                               FontSize="11"
                                               Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Close Button -->
                                <Button Grid.Column="2"
                                        Classes="btn-secondary"
                                        Command="{Binding CloseFaqCommand}"
                                        Height="24"
                                        Padding="8,0"
                                        VerticalAlignment="Center"
                                        ToolTip.Tip="{Binding [Faq_Close], Source={x:Static loc:LocalizationManager.Instance}}">
                                    <TextBlock Text="✕" FontSize="11" FontWeight="Bold" Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- 2. Search Box -->
                        <Border Grid.Row="1" Padding="16,10,16,6">
                            <TextBox Text="{Binding FaqSearchQuery, Mode=TwoWay}"
                                     Watermark="{Binding [Faq_SearchPlaceholder], Source={x:Static loc:LocalizationManager.Instance}}"
                                     FontSize="11.5"
                                     Padding="12,7"
                                     CornerRadius="7" />
                        </Border>

                        <!-- 3. Category Filter Chips -->
                        <ItemsControl Grid.Row="2"
                                      ItemsSource="{Binding FaqCategories}"
                                      Margin="16,2,16,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="appModels:FaqCategoryItem">
                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFaqCategoryCommand}"
                                            CommandParameter="{Binding Id}"
                                            Padding="10,4"
                                            Margin="0,0,6,6"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            CornerRadius="6"
                                            BorderThickness="1"
                                            Background="{Binding BackgroundBrush}"
                                            BorderBrush="{Binding BorderBrushColor}"
                                            Foreground="{Binding ForegroundBrush}"
                                            Content="{Binding HeaderText}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 4. Scrollable FAQ Accordion List -->
                        <ScrollViewer Grid.Row="3"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto"
                                      Padding="16,0,16,16">
                            <StackPanel Spacing="6">
                                <!-- No Results Notice (if empty) -->
                                <Border IsVisible="{Binding HasNoFaqResults}"
                                        Background="#201C1C1E"
                                        BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="20"
                                        Margin="0,16,0,0">
                                    <StackPanel Spacing="5" HorizontalAlignment="Center">
                                        <TextBlock Text="🔍" FontSize="22" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding [Faq_NoResults], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                                   HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding [Faq_NoResults_Desc], Source={x:Static loc:LocalizationManager.Instance}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   HorizontalAlignment="Center"
                                                   TextAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- FAQ Items List -->
                                <ItemsControl ItemsSource="{Binding FilteredFaqItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="appModels:FaqItem">
                                            <Border Background="#201C1C1E"
                                                    BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Margin="0,0,0,6">
                                                <StackPanel>
                                                    <!-- Card Header (Expander trigger) -->
                                                    <Button Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ToggleFaqItemExpandedCommand}"
                                                            CommandParameter="{Binding}"
                                                            HorizontalAlignment="Stretch"
                                                            HorizontalContentAlignment="Stretch"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            Padding="12,9"
                                                            CornerRadius="8">
                                                        <Grid ColumnDefinitions="Auto, *, Auto">
                                                            <Border Grid.Column="0"
                                                                    Background="#2A2A2E"
                                                                    CornerRadius="4"
                                                                    Padding="6,2"
                                                                    Margin="0,0,10,0"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding CategoryName}"
                                                                           FontSize="9"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}" />
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Title}"
                                                                       FontSize="11.5"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,10,0" />

                                                            <Border Grid.Column="2"
                                                                    Width="22" Height="22"
                                                                    CornerRadius="11"
                                                                    Background="#2A2A2E"
                                                                    VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ExpandIcon}"
                                                                           FontSize="9.5"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Button>

                                                    <!-- Expanded Details -->
                                                    <Border IsVisible="{Binding IsExpanded}"
                                                            BorderBrush="{StaticResource ThemeDividerBrush}"
                                                            BorderThickness="0,1,0,0"
                                                            Padding="14,12"
                                                            Background="#16161A">
                                                        <StackPanel Spacing="9">
                                                            <!-- Symptom -->
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding [Faq_Label_Symptom], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ThemeSystemRedBrush}" />
                                                                <TextBlock Text="{Binding Symptom}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Root Cause -->
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding [Faq_Label_Cause], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ThemeSystemOrangeBrush}" />
                                                                <TextBlock Text="{Binding Cause}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource ThemeLabelSecondaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Solution -->
                                                            <StackPanel Spacing="2">
                                                                <TextBlock Text="{Binding [Faq_Label_Solution], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                           FontSize="10"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource ThemeSystemGreenBrush}" />
                                                                <TextBlock Text="{Binding Solution}"
                                                                           FontSize="11"
                                                                           Foreground="{StaticResource ThemeLabelPrimaryBrush}"
                                                                           TextWrapping="Wrap" />
                                                            </StackPanel>

                                                            <!-- Command Snippet with Copy Button -->
                                                            <Border IsVisible="{Binding HasCommand}"
                                                                    Background="#0B0D11"
                                                                    BorderBrush="{StaticResource ThemeBorderSubtleBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="5"
                                                                    Padding="10,8"
                                                                    Margin="0,4,0,0">
                                                                <Grid ColumnDefinitions="*, Auto">
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding CommandCode}"
                                                                               FontFamily="Cascadia Code, Consolas, monospace"
                                                                               FontSize="10"
                                                                               Foreground="{StaticResource ThemeAccentBlueHoverBrush}"
                                                                               TextWrapping="Wrap"
                                                                               VerticalAlignment="Center"
                                                                               Margin="0,0,10,0" />
                                                                    <Button Grid.Column="1"
                                                                            Classes="btn-secondary"
                                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CopyFaqCommandTextCommand}"
                                                                            CommandParameter="{Binding CommandCode}"
                                                                            Padding="8,2"
                                                                            Height="24"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding [Faq_Label_CopyCommand], Source={x:Static loc:LocalizationManager.Instance}}"
                                                                                   FontSize="9.5"
                                                                                   Foreground="{StaticResource ThemeAccentBlueBrush}" />
                                                                    </Button>
                                                                </Grid>
                                                            </Border>
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>

        </Grid>
    </Panel>
</Window>