<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="using:ScrcpyDex.App.Converters"
             x:Class="ScrcpyDex.App.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://ScrcpyDex.App/Styles/ThemeColors.axaml" />
                <ResourceInclude Source="avares://ScrcpyDex.App/Styles/ThemeIcons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Value Converters -->
            <converters:StatusToBrushConverter x:Key="StatusToBrushConverter" />
            <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter" />
            <converters:LogEntryBrushConverter x:Key="LogEntryBrushConverter" />
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://ScrcpyDex.App/Styles/ThemeControls.axaml" />
    </Application.Styles>
</Application>
