<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Typography & Default Controls (AudioEspacial Precision Instrument Identity) -->
    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, sans-serif" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
    </Style>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, sans-serif" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="#454552" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Opacity" Value="0.38" />
    </Style>

    <!-- Primary Orange Action Button (Start Session / Primary Action) -->
    <Style Selector="Button.btn-primary">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeBrush}" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentOrangeBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeHoverBrush}" />
        <Setter Property="BorderBrush" Value="#FFB066" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.btn-primary:disabled /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeLabelSecondaryBrush}" />
    </Style>

    <!-- Secondary Action Button (Scan / Auxiliary) -->
    <Style Selector="Button.btn-secondary">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelBrightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="#454552" />
        <Setter Property="TextBlock.Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
    </Style>

    <!-- Destructive / Active Stop Action Button -->
    <Style Selector="Button.btn-destructive">
        <Setter Property="Background" Value="#2A1717" />
        <Setter Property="Foreground" Value="#F5F5F7" />
        <Setter Property="BorderBrush" Value="#FF453A" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Button.btn-destructive:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#3A1E1E" />
        <Setter Property="BorderBrush" Value="#FF6961" />
        <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Circular Header Icon Button (26x26, Radius 13, matches AudioEspacial CloseButton) -->
    <Style Selector="Button.circle-icon">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.circle-icon:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="#484854" />
    </Style>

    <!-- Compact Pill Action Button (for Settings / Console / FAQ triggers) -->
    <Style Selector="Button.pill-button">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelBrightBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.pill-button:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentOrangeBorderBrush}" />
        <Setter Property="TextBlock.Foreground" Value="#F5F5F7" />
    </Style>

    <!-- Smooth Header Transition for Settings Gear <-> Back Button -->
    <Style Selector="Button.top-header-swap[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.18" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Smooth Width & Entry Transition for Rescan + Wi-Fi Transition Button -->
    <Style Selector="Button.rescan-morph">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Width" Duration="0:0:0.22" Easing="CubicEaseOut" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.wifi-swap-btn[IsVisible=True]">
        <Style.Animations>
            <Animation Duration="0:0:0.22" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="1" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Pulsing Orange Telemetry Card & Badge when Connected Wirelessly -->
    <Style Selector="Border.wireless-telemetry">
        <Style.Animations>
            <Animation Duration="0:0:1.6" IterationCount="INFINITE" PlaybackDirection="Alternate" Easing="SineEaseInOut">
                <KeyFrame Cue="0%">
                    <Setter Property="BorderBrush" Value="#553214" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="BorderBrush" Value="#FF7A00" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Sequential 3-Dot Wave Animation while Session is Starting -->
    <Style Selector="Ellipse.loading-dot-1">
        <Style.Animations>
            <Animation Duration="0:0:1.05" IterationCount="INFINITE" Delay="0:0:0">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Ellipse.loading-dot-2">
        <Style.Animations>
            <Animation Duration="0:0:1.05" IterationCount="INFINITE" Delay="0:0:0.22">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
    <Style Selector="Ellipse.loading-dot-3">
        <Style.Animations>
            <Animation Duration="0:0:1.05" IterationCount="INFINITE" Delay="0:0:0.44">
                <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="35%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                <KeyFrame Cue="70%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- Subtle Raised Card (#16161C, Border #2B2B33, Radius 14) -->
    <Style Selector="Border.glass-card">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="{StaticResource ThemeCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,10" />
    </Style>

    <!-- Recessed Well Surface (#111115, Border #2B2B33, Radius 12) -->
    <Style Selector="Border.recessed-well">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{StaticResource ThemeWellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
    </Style>

    <!-- Toggle Switch Styling (Orange #FF7A00 when active, Recessed #111115 when off) -->
    <Style Selector="ToggleSwitch.dex-switch">
        <Setter Property="OnContent" Value="" />
        <Setter Property="OffContent" Value="" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleSwitch.dex-switch /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource ThemeWellBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="20" />
    </Style>
    <Style Selector="ToggleSwitch.dex-switch:checked /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentOrangeBorderBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.dex-switch:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
    </Style>
    <Style Selector="ToggleSwitch.dex-switch:checked:pointerover /template/ Border#SwitchKnobBounds">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeAccentOrangeBorderBrush}" />
    </Style>

    <!-- Dropdown ComboBox (Expands on click, styled in #24242C / #35353E) -->
    <Style Selector="ComboBox.dex-combobox">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Height" Value="28" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,0,8,0" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, sans-serif" />
    </Style>
    <Style Selector="ComboBox.dex-combobox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource ThemeControlHoverBrush}" />
        <Setter Property="BorderBrush" Value="#484854" />
    </Style>

    <!-- Borderless Header Device Selector ComboBox (Reveals box on hover, expands on click) -->
    <Style Selector="ComboBox.dex-header-combobox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="6,2,4,2" />
        <Setter Property="Margin" Value="-6,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, sans-serif" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox /template/ Border#Background">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox:pointerover /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox:dropdownopen /template/ Border#Background">
        <Setter Property="Background" Value="{StaticResource ThemeControlBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#484854" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox /template/ TextBlock#PlaceholderTextBlock">
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="#86868B" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox:pointerover /template/ PathIcon#DropDownGlyph">
        <Setter Property="Foreground" Value="#F5F5F7" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox ComboBoxItem">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox TextBlock.device-serial-in-popup">
        <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ComboBox.dex-header-combobox ComboBoxItem TextBlock.device-serial-in-popup">
        <Setter Property="IsVisible" Value="True" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style Selector="ComboBoxItem">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="2,1" />
    </Style>
    <Style Selector="ComboBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeBrush}" />
        <Setter Property="TextBlock.Foreground" Value="#F5F5F7" />
    </Style>

    <!-- TextBox Styling -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{StaticResource ThemeWellBackgroundBrush}" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ThemeControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="FontFamily" Value="fonts:Inter#Inter, Inter, Segoe UI, sans-serif" />
    </Style>

    <!-- Popover & Menu Flyout Styling -->
    <Style Selector="FlyoutPresenter">
        <Setter Property="Background" Value="#16161C" />
        <Setter Property="BorderBrush" Value="#33333C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="2" />
    </Style>

    <Style Selector="MenuFlyoutPresenter">
        <Setter Property="Background" Value="#16161C" />
        <Setter Property="BorderBrush" Value="#33333C" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style Selector="MenuItem">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource ThemeLabelPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#root">
        <Setter Property="Background" Value="{StaticResource ThemeAccentOrangeBrush}" />
    </Style>

</Styles>
