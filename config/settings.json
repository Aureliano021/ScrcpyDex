{
  "version": "2.0",
  "display": {
    "resolution": "1920x1080 (FHD)",
    "width": 1920,
    "height": 1080,
    "dpi": 160,
    "fps": 30,
    "bitrate": 8000000,
    "codec": "h264",
    "windowMode": "normal",
    "renderDriver": "auto"
  },
  "audio": {
    "enabled": true,
    "bufferMs": 50
  },
  "input": {
    "mouseDriver": "uhid",
    "releaseKey": "LeftAlt",
    "forwardShortcuts": false
  },
  "device": {
    "turnScreenOff": false,
    "stayAwake": false,
    "autoConnect": false
  },
  "ui": {
    "theme": "dark",
    "showLogPanel": true
  }
}
